# Copy this file to .env.local for local development (Vercel injects these
# automatically in production when you add them in Project Settings > Environment
# Variables — BLOB_READ_WRITE_TOKEN is added for you automatically when you
# connect a Vercel Blob store to the project).

# Required — sign/verify login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# Optional — seeded admin account created the first time the app runs and
# no users exist yet. Change the password after your first login.
ADMIN_EMAIL=admin@devtrack.local
ADMIN_PASSWORD=ChangeMe123!

# Optional locally. Vercel Blob storage token — required in production
# (Vercel sets this for you once you add a Blob store to the project, from
# the Storage tab). If left unset, the app falls back to writing JSON files
# under ./data on local disk, so you can develop without a Vercel account.
# Only used when STORAGE_DRIVER (below) is "json" (the default).
BLOB_READ_WRITE_TOKEN=

# ----------------------------------------------------------------------------
# Storage backend — see lib/store.js. Two interchangeable drivers:
#   json  — the above (Vercel Blob / local-disk JSON files). Default.
#   mysql — real relational tables. Needs DATABASE_URL or the MYSQL_* vars
#           below. Schema is created automatically on first use — nothing to
#           run by hand (see lib/storage/mysqlSchema.sql for the reference).
# You can flip this with the env var here, or by editing the STORAGE_DRIVER
# constant directly at the top of lib/store.js — either works, the constant
# is just what applies when this var is unset.
STORAGE_DRIVER=json


# Only used when STORAGE_DRIVER=mysql. Either set DATABASE_URL (takes
# priority) as one connection string:
#   DATABASE_URL=mysql://user:password@host:3306/devtrack
# ...or set these instead:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=devtrack
# Keep this low for serverless hosts (each function instance opens its own
# pool) — a normal always-on server can raise it.
MYSQL_CONNECTION_LIMIT=5
